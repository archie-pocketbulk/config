#!/bin/sh
# Mosh shell on the remote dev box (ssh host "mini", see client/README.md) if reachable, else local zellij.
if ssh -o BatchMode=yes -o ConnectTimeout=2 mini true 2>/dev/null; then
    # ssh only logs in; mosh-server is not on the non-login PATH, so give its brew path
    exec mosh --server=/opt/homebrew/bin/mosh-server mini -- zellij attach -c main
fi
echo "mini unreachable, using local zellij" >&2; sleep 1
exec zellij
